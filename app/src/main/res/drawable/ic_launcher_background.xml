<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="600"
    android:viewportHeight="600">

    <!-- Solid base background -->
    <path
        android:fillColor="#0B0E14"
        android:pathData="M 0,0 L 600,0 L 600,600 L 0,600 Z" />

    <!-- First light gradient (simulating blurred ellipse at 396, 218) -->
    <path android:pathData="M 0,0 L 600,0 L 600,600 L 0,600 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="396.697"
                android:centerY="218.0"
                android:gradientRadius="450"
                android:type="radial">
                <item android:offset="0.0" android:color="#6B13203B"/>
                <item android:offset="1.0" android:color="#0013203B"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Second light gradient (simulating blurred ellipse at 241, 358) -->
    <path android:pathData="M 0,0 L 600,0 L 600,600 L 0,600 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="241.697"
                android:centerY="358.0"
                android:gradientRadius="400"
                android:type="radial">
                <item android:offset="0.0" android:color="#293B2E13"/>
                <item android:offset="1.0" android:color="#003B2E13"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
